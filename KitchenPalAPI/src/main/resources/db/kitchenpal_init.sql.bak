-- ============================================================
-- KitchenPal 厨房小助手 - MySQL 数据库初始化脚本
-- ============================================================

-- 创建数据库
CREATE DATABASE IF NOT EXISTS kitchenpal_db DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

USE kitchenpal_db;

-- ============================================================
-- 1. 食谱表 recipes
-- ============================================================
DROP TABLE IF EXISTS recipes;
CREATE TABLE recipes (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '食谱ID',
    title VARCHAR(200) NOT NULL COMMENT '食谱名称',
    subtitle VARCHAR(500) COMMENT '副标题/简介',
    image_url VARCHAR(500) COMMENT '封面图片URL',
    rating FLOAT DEFAULT 4.5 COMMENT '评分',
    cook_time_min INT DEFAULT 30 COMMENT '烹饪时间（分钟）',
    calories INT DEFAULT 300 COMMENT '卡路里',
    difficulty VARCHAR(20) DEFAULT '简单' COMMENT '难度：简单/中等/困难',
    category VARCHAR(50) DEFAULT '家常菜' COMMENT '分类',
    tags VARCHAR(2000) COMMENT '标签，逗号分隔',
    match_percent INT COMMENT '匹配度百分比',
    ingredients_json TEXT COMMENT '食材JSON数组',
    steps_json TEXT COMMENT '步骤JSON数组',
    is_hero TINYINT(1) DEFAULT 0 COMMENT '是否首页推荐 0否1是',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='食谱表';

-- ============================================================
-- 2. 用户表 users
-- ============================================================
DROP TABLE IF EXISTS users;
CREATE TABLE users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '用户ID',
    phone VARCHAR(20) UNIQUE NOT NULL COMMENT '手机号',
    nickname VARCHAR(100) COMMENT '昵称',
    password VARCHAR(100) COMMENT '密码',
    avatar VARCHAR(500) COMMENT '头像URL',
    taste_preferences VARCHAR(500) COMMENT '口味偏好，逗号分隔',
    cooking_count INT DEFAULT 0 COMMENT '烹饪次数',
    favorite_count INT DEFAULT 0 COMMENT '收藏数',
    streak_days INT DEFAULT 0 COMMENT '连续烹饪天数',
    dark_mode TINYINT(1) DEFAULT 0 COMMENT '深色模式 0关1开',
    cooking_notify TINYINT(1) DEFAULT 1 COMMENT '烹饪提醒 0关1开',
    status TINYINT(1) DEFAULT 1 COMMENT '状态 1正常 0禁用',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='用户表';

-- ============================================================
-- 3. 收藏表 favorites
-- ============================================================
DROP TABLE IF EXISTS favorites;
CREATE TABLE favorites (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '收藏ID',
    user_id BIGINT NOT NULL COMMENT '用户ID',
    recipe_id BIGINT NOT NULL COMMENT '食谱ID',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '收藏时间',
    UNIQUE KEY uk_user_recipe (user_id, recipe_id),
    KEY idx_user_id (user_id),
    KEY idx_recipe_id (recipe_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='收藏表';

-- ============================================================
-- 4. 通知表 notifications
-- ============================================================
DROP TABLE IF EXISTS notifications;
CREATE TABLE notifications (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '通知ID',
    user_id BIGINT COMMENT '用户ID，NULL表示全体通知',
    type VARCHAR(50) DEFAULT 'system' COMMENT '通知类型：system/cooking',
    title VARCHAR(200) NOT NULL COMMENT '通知标题',
    content VARCHAR(500) COMMENT '通知内容',
    icon VARCHAR(100) COMMENT '图标名称',
    is_read TINYINT(1) DEFAULT 0 COMMENT '是否已读 0未读1已读',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '发送时间',
    KEY idx_user_id (user_id),
    KEY idx_is_read (is_read)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='通知表';

-- ============================================================
-- 5. 烹饪历史表 cooking_history
-- ============================================================
DROP TABLE IF EXISTS cooking_history;
CREATE TABLE cooking_history (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '记录ID',
    user_id BIGINT NOT NULL COMMENT '用户ID',
    recipe_id BIGINT COMMENT '食谱ID',
    recipe_title VARCHAR(200) COMMENT '食谱名称（冗余）',
    recipe_image_url VARCHAR(500) COMMENT '食谱图片（冗余）',
    cook_date VARCHAR(50) COMMENT '烹饪日期',
    cook_time VARCHAR(50) COMMENT '烹饪时间点',
    duration_min INT COMMENT '实际用时（分钟）',
    score INT COMMENT '完成评分（0-100）',
    rating INT COMMENT '用户评价星级（1-5）',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '记录时间',
    KEY idx_user_id (user_id),
    KEY idx_cook_date (cook_date)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='烹饪历史表';

-- ============================================================
-- 6. 管理员表 admin_users
-- ============================================================
DROP TABLE IF EXISTS admin_users;
CREATE TABLE admin_users (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '管理员ID',
    username VARCHAR(50) UNIQUE NOT NULL COMMENT '用户名',
    password VARCHAR(100) NOT NULL COMMENT '密码（BCrypt加密）',
    nickname VARCHAR(100) COMMENT '昵称',
    role VARCHAR(20) DEFAULT 'admin' COMMENT '角色：admin/super_admin',
    status TINYINT(1) DEFAULT 1 COMMENT '状态 1正常 0禁用',
    last_login_at DATETIME COMMENT '最后登录时间',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='管理员表';

-- ============================================================
-- 7. AI识别日志表 scan_logs
-- ============================================================
DROP TABLE IF EXISTS scan_logs;
CREATE TABLE scan_logs (
    id BIGINT PRIMARY KEY AUTO_INCREMENT COMMENT '日志ID',
    user_id BIGINT COMMENT '用户ID',
    detected_ingredients VARCHAR(1000) COMMENT '识别到的食材JSON',
    suggested_recipe_ids VARCHAR(500) COMMENT '推荐食谱ID列表',
    scan_time DATETIME DEFAULT CURRENT_TIMESTAMP COMMENT '识别时间',
    status VARCHAR(20) DEFAULT 'success' COMMENT '状态：success/fallback/error',
    error_msg VARCHAR(500) COMMENT '错误信息',
    KEY idx_user_id (user_id),
    KEY idx_scan_time (scan_time),
    KEY idx_status (status)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='AI识别日志表';

-- ============================================================
-- 数据初始化
-- ============================================================

