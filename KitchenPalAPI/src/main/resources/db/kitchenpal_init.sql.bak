 '[{"name":"干木耳","amount":"30g","iconName":"leaf"},{"name":"小米椒","amount":"3个","iconName":"flask"},{"name":"蒜末","amount":"4瓣","iconName":"garlic"},{"name":"香菜","amount":"适量","iconName":"leaf"},{"name":"香醋","amount":"2勺","iconName":"flask"}]',
