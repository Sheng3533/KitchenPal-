(42, '干锅花菜', '干香微辣，越吃越香', '/images/42.jpg',
 4.6, 20, 220, '简单', '川菜', '香辣,下饭', 78,
 '[{"name":"有机花菜","amount":"400g","iconName":"leaf"},{"name":"五花肉","amount":"100g","iconName":"beef"},{"name":"干辣椒","amount":"6个","iconName":"flask"},{"name":"蒜片","amount":"3瓣","iconName":"garlic"},{"name":"豆瓣酱","amount":"1勺","iconName":"flask"}]',
 '[{"title":"撕花菜","description":"花菜掰成小朵，用淡盐水浸泡10分钟后沥干","heat":"无需火候","durationSeconds":600,"tip":"手撕比刀切更入味，断面不规则更挂汁"},{"title":"煸花菜","description":"热锅少油下花菜中火干煸3分钟至边缘微焦盛出","heat":"中火","durationSeconds":180,"tip":"先干煸逼出水分，成品才不软塌"},{"title":"煸肉","description":"下五花肉片煸至出油微卷","heat":"中火","durationSeconds":120,"tip":"肉片煸出油后更香，也能减少用油"},{"title":"炒底料","description":"加豆瓣酱、干辣椒、蒜片小火炒出红油","heat":"小火","durationSeconds":90,"tip":"豆瓣酱一定要炒出红油才够香"},{"title":"合炒","description":"倒回花菜，加生抽和少许糖大火翻炒均匀出锅","heat":"大火","durationSeconds":90,"tip":"最后大火收一下锅气更足"}]',
