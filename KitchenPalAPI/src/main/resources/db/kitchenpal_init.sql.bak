(37, '口水鸡', '麻辣鲜香，川味凉菜', '/images/37.jpg',
 4.7, 30, 320, '中等', '凉菜', '麻辣,开胃', 78,
 '[{"name":"三黄鸡","amount":"半只","iconName":"beef"},{"name":"花生碎","amount":"30g","iconName":"leaf"},{"name":"辣椒油","amount":"3勺","iconName":"flask"},{"name":"花椒粉","amount":"1勺","iconName":"flask"},{"name":"蒜末","amount":"4瓣","iconName":"garlic"},{"name":"小葱","amount":"2根","iconName":"leaf"}]',
 '[{"title":"煮鸡","description":"整鸡冷水下锅，加姜片葱段和料酒，中火煮15分钟后关火焖10分钟","heat":"中火","durationSeconds":1500,"tip":"筷子插鸡腿最厚处无血水即熟，焖比久煮更嫩"},{"title":"冰镇定型","description":"捞出整鸡立刻放入冰水中浸10分钟至完全冷却","heat":"无需火候","durationSeconds":600,"tip":"冰水激过鸡皮才爽滑弹牙"},{"title":"斩件码盘","description":"沥干水分剁成均匀长条，鸡皮朝上码入盘中","heat":"无需火候","durationSeconds":180,"tip":"刀要快、下刀利落，鸡肉才不散"},{"title":"调红油汁","description":"辣椒油、蒜末、花椒粉、生抽、香醋、白糖加少许鸡汤调匀","heat":"无需火候","durationSeconds":120,"tip":"汁略咸一点，浇上才够味"},{"title":"浇汁撒料","description":"红油汁淋满鸡块，撒花生碎和小葱花即成","heat":"无需火候","durationSeconds":60,"tip":"现浇现吃，久放鸡皮会出水"}]',
 0),
(38, '夫妻肺片', '麻辣爽口，川味经典', '/images/38.jpg',
 4.7, 40, 290, '中等', '凉菜', '麻辣,经典', 76,
 '[{"name":"牛腱肉","amount":"300g","iconName":"beef"},{"name":"牛肚","amount":"150g","iconName":"beef"},{"name":"花生碎","amount":"30g","iconName":"leaf"},{"name":"辣椒油","amount":"4勺","iconName":"flask"},{"name":"花椒粉","amount":"1勺","iconName":"flask"},{"name":"香菜","amount":"适量","iconName":"leaf"}]',
 '[{"title":"卤牛肉","description":"牛腱肉冷水下锅焯水，加卤料小火卤40分钟后捞出晾凉","heat":"小火","durationSeconds":2400,"tip":"卤完浸泡半小时更入味，晾凉再切才成形"},{"title":"卤牛肚","description":"牛肚洗净焯水，同卤水煮30分钟至软糯","heat":"小火","durationSeconds":1800,"tip":"牛肚要煮到筷子能扎透"},{"title":"切片","description":"牛肉与牛肚均切成薄而匀的片状","heat":"无需火候","durationSeconds":300,"tip":"越薄越易挂汁，逆纹切口感更嫩"},{"title":"调红油","description":"辣椒油、花椒粉、生抽、香醋、白糖、蒜末调成味汁","heat":"无需火候","durationSeconds":120,"tip":"麻辣味要压住甜味，糖只提鲜"},{"title":"拌制","description":"肉片淋味汁拌匀，撒花生碎和香菜","heat":"无需火候","durationSeconds":60,"tip":"拌好后稍静置2分钟更入味"}]',
 0),
(39, '蒜泥白肉', '蒜香浓郁，肥而不腻', '/images/39.jpg',
 4.6, 35, 360, '简单', '凉菜', '蒜香,下饭', 74,
 '[{"name":"五花肉","amount":"400g","iconName":"beef"},{"name":"蒜末","amount":"6瓣","iconName":"garlic"},{"name":"辣椒油","amount":"2勺","iconName":"flask"},{"name":"生抽","amount":"2勺","iconName":"flask"},{"name":"小葱","amount":"2根","iconName":"leaf"}]',
 '[{"title":"煮肉","description":"五花肉整块冷水下锅，加姜葱料酒中火煮25分钟","heat":"中火","durationSeconds":1500,"tip":"肉块别切小，整块煮才不柴"},{"title":"晾凉","description":"捞出沥干，放凉后入冰箱冷藏20分钟","heat":"无需火候","durationSeconds":1200,"tip":"冷透再切，片薄而不碎"},{"title":"切薄片","description":"取出去皮，横刀片成极薄的肉片","heat":"无需火候","durationSeconds":300,"tip":"刀身放平慢慢推，片越薄越好吃"},{"title":"调蒜泥汁","description":"蒜末加生抽、辣椒油、白糖和少许肉汤调匀","heat":"无需火候","durationSeconds":120,"tip":"蒜末要现捣，静置一会蒜香更冲"},{"title":"浇汁","description":"肉片码盘浇上蒜泥汁，撒葱花","heat":"无需火候","durationSeconds":60,"tip":"食用前再浇汁，避免肉片出水"}]',
 0),
(40, '凉拌木耳', '爽脆开胃，低脂健康', '/images/40.jpg',
